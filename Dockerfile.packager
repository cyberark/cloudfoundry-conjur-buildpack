FROM golang:1.26.7-alpine

RUN apk update && apk add --no-cache bash
ARG GOPROXY=https://proxy.golang.org,direct
RUN --mount=type=secret,id=gonetrc if [ -s /run/secrets/gonetrc ]; then export NETRC=/run/secrets/gonetrc; fi && go install github.com/cloudfoundry/libbuildpack/packager/buildpack-packager@latest
